# ════════════════════════════════════════════════════════
#  Axiom — required environment variables
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ════════════════════════════════════════════════════════

# ── AI / LLM ─────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# ── Somnia Wallet ─────────────────────────────────────────
# Your deployer wallet private key (with 0x prefix)
# NEVER commit this file once filled in
# Testnet (STT): get free tokens at https://testnet.somnia.network
# Mainnet (SOMI): need >= 32 SOMI to register Reactivity subscriptions
SOMNIA_PRIVATE_KEY=0xyour_wallet_private_key_here

# ── Network ───────────────────────────────────────────────
# Start with testnet (Chain ID 50312)
# Mainnet RPC:  https://api.infra.mainnet.somnia.network  (Chain ID: 5031)
# Testnet RPC:  https://api.infra.testnet.somnia.network  (Chain ID: 50312)
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
SOMNIA_CHAIN_ID=50312

# ── Deployed Infrastructure (fill in after running deploy:infra) ──────────
# After deploying ProvenanceRegistry and ComplianceLog, paste addresses here
PROVENANCE_REGISTRY_ADDRESS=
COMPLIANCE_LOG_ADDRESS=
